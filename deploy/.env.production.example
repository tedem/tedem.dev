# Production .env for tedem.dev. On the server: cp deploy/.env.production.example .env,
# fill in the blanks, then run php artisan deploy:install (it generates APP_KEY).

APP_NAME=tedem
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tedem.dev

# Admin and auth pages; the public site's language comes from the URL.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tedem
DB_USERNAME=tedem
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker runs on the server, so queued jobs run right away.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail is not set up yet: messages (password resets) only go to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tedem.dev"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
